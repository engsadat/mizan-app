# SQLite dev database (generated at runtime by import_excel.py)
instance/
*.db

# Environment / secrets — never commit
.env
.env.*

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv/

# Temp Excel copies created by load_copy()
*.tmp.xlsx

# Excel data files (should not be tracked in git)
# Override with EXCEL_SOURCES environment variables in production
data/**/*.xlsx

# Git worktrees
.worktrees/
